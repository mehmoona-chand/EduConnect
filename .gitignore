# ========================
# EduConnect — .gitignore
# ========================

# Database credentials & config
config.php
.env
.env.local

# Uploaded user files (tutor/course images)
uploads/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE & editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# XAMPP / WAMP logs
*.log

# Composer (if added later)
vendor/
composer.lock

# Node (if added later)
node_modules/
package-lock.json

# Temp / backup files
*.tmp
*.bak
*.swp
*~
